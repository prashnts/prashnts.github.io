extends templates/base.jade

block prepend head
  -
    var page = {
      title: 'no-op / resume',
      url: 'https://noop.pw/resume',
      description: "Le CV de Prashant.",
    }
  +meta(page)

mixin ilink(icon, url)
  - var title = url.replace(/https?:\/\//, '')
  a(rel='noopener noreferrer' href=url title=title target='_blank')
    i.icon(class='icon-' + icon)
    span= title

mixin emospan(emo, content)
  span #[i.icon.emoji= emo] #{content}

mixin title_link(icon, title, url)
  a(rel='noopener noreferrer' href=url title=title target='_blank')
    i.icon(class='icon-' + icon)
    span= title
    span.onlyprint= url

mixin email(email)
  a(href='mailto:' + email)
    i.icon.icon-mail
    span= email
    span.onlyprint= url

mixin ispan(icon, content)
  span #[i.icon(class='icon-' + icon)] #{content}

block append stylesheets
  link(rel='stylesheet' href='https://fonts.googleapis.com/css?family=Karla:400,400i,700')

block prepend body
  body.vita.locale_fr: main
    header
      - var n = vita.personal.name.split(' ')
      div
        h1 #[span= n[0]] #{n[1]}
        p #{vita.personal.title}
      div.controls
        div
          a.btn_42(href='#' onclick="window.print()") ⌘ PDF
          a.btn_42(href='/resume_en') English Version ➔

    section.info
      div
        h1 Web
        ul
          li: +ilink('link', vita.info.homepage)
          li: +ilink('git', vita.info.github)
          //- li: +ilink('twitter', vita.info.twitter)
          li: +ilink('link', vita.info.printables)
          li: +title_link('link', 'Google Scholar', vita.info.google_scholar)
      div
        h1 Info
        ul
          li: +email(vita.info.email)
          li: +ispan('location', vita.info.location)
        ul: each slang in vita.info.spoken_languages
          - var lang_info = slang.label + ' - ' + slang.level
          li: +emospan(slang.icon, lang_info)

    section.cover
      h1 Aperçu
      p !{vita.cover}

    section.xp
      ul#filtered
        input(type="checkbox")#filter_checkbox
        input(type="checkbox" checked)#filter_professional
        div.controls
          h1 Expérience
          div
            label(for="filter_checkbox").fbtn.uni Universitaire
            label(for="filter_professional").fbtn.pro Professionelle
        - var prev_xp = null
        - each xp in vita.experience
          - pro = xp.professional ? 'pro' : 'academic'
          li(class= pro)
            aside
              if !(prev_xp && prev_xp.company == xp.company)
                h2.company= xp.company
              p.position= xp.position
              p.dates
                +ispan('calendar', xp.dates.interval)
                //- span.duration #{xp.dates.duration}
              //- if !(prev_xp && prev_xp.location == xp.location)
              p.location: +ispan('location', xp.location)
              //- ul.tags: each tag in xp.tags || []
              //-   li= tag
            div.description
              !{xp.description}
              if xp.links
                div.extra_links
                  ul: each link in  xp.links
                    li: +title_link('link', link.title, link.url)
              if xp.website
                p.website: +ilink('link', xp.website)
          - prev_xp = xp

    //- section.talks
    //-   div.controls
    //-     h1 Conférences et ateliers
    //-   ul: each talk in vita.talks_and_workshops
    //-     li
    //-       aside
    //-         h2.conference= talk.conference
    //-         p.location: +ispan('location', talk.location)
    //-         p.dates
    //-           +ispan('calendar', talk.dates.interval)
    //-         p.position= talk.type
    //-         //- ul.tags: each tag in talk.tags || []
    //-         //-   li= tag
    //-       div.description
    //-         !{talk.description}
    //-         if talk.website
    //-           p.website: +ilink('link', talk.website)

    section.publications
      div.controls
        h1 Publications
      ul: each pub in vita.publications
        li
          div
            h3= pub.title
            if pub.authors
              p= pub.authors
            div.journal_info
              if pub.doi
                p.doi: +ilink('lock', 'https://doi.org/' + pub.doi)
              if pub.journal
                p.subtitle #{pub.journal}, #{pub.year}
            if pub.pdf_closed
              p.no-print: +title_link('link', 'PDF (Draft)', pub.pdf_closed)
            if pub.pdf
              p.no-print: +title_link('link', 'PDF', pub.pdf)

    section.edu
      div.controls
        h1 Éducation
      ul: each edu in vita.education
        li
          aside
            h2.institute= edu.institute
            p.position= edu.position
            p.dates: +ispan('calendar', edu.dates.interval)
            p.location: +ispan('location', edu.location)
          div.description
            h3.degree= edu.degree
            dl
              if edu.major
                div
                  dt Spécialisation
                  dd= edu.major
              if edu.minor
                div
                  dt Secondaires
                  dd= edu.minor
              if edu.percentage
                div
                  dt Percentage
                  dd #{edu.percentage}%
              if edu.grade
                div
                  dt Grade
                  dd= edu.grade

    section.open_source
      div.controls
        h1 Open Source
      ul: each package in vita.open_source
        li
          div.description
            !{package.description}

            p: +ilink('git', 'https://github.com/' + package.repo)
            if package.links
              each link in package.links
                div: +title_link('link', link.title, link.link)

    section.skills
      div.controls
        h1 Skills
      - var skill_map = ['Notions', 'Intermédiaire', 'Maîtrise', 'Avancé', 'Expert']
      ul: each skset, kind in vita.skills
        li
          h2= kind
          ul: each sk in skset
            li.skill
              span.skill= sk[0]
              div.labels
                span= skill_map[sk[1] - 1]
                //- #[i.dots= '●'.repeat(sk[1])]

    footer
      ul
        li Robot ? Jetez un œil au #[a(href='https://github.com/prashnts/prashnts.github.io/blob/develop/riptide/vita-fr.yaml'): code source YAML] de ce document.
        li Généré #[code #{_now.format('D MMM Y')}]
      code.kthx :wq
